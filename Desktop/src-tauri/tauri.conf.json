{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Goal Manager",
  "version": "0.2.3",
  "identifier": "com.nisos.projectgoalmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Goal Manager",
        "width": 1380,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "it-IT"
      },
      "nsis": {
        "languages": [
          "Italian"
        ]
      }
    }
  }
}
