{
  "name": "project-goal-manager",
  "private": true,
  "version": "0.2.5",
  "description": "Roadmap e todo di progetto, in locale o su cartella di rete",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:en": "vite --mode en",
    "build": "vue-tsc --noEmit && vite build",
    "build:en": "vue-tsc --noEmit && vite build --mode en",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:build:it": "tauri build",
    "tauri:build:en": "tauri build --config src-tauri/tauri.en.conf.json",
    "tauri:exe:it": "tauri build --no-bundle",
    "tauri:exe:en": "tauri build --no-bundle --config src-tauri/tauri.en.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && vitest run && playwright test",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-os": "^2.3.0",
    "@tauri-apps/plugin-window-state": "^2.4.0",
    "@vueuse/core": "^13.9.0",
    "dayjs": "^1.11.13",
    "lucide-vue-next": "^0.577.0",
    "nanoid": "^5.1.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.0",
    "vue": "^3.5.20",
    "vue-router": "^4.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
